# ============================================================
# PDF Chat - Environment Configuration
# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env
# ============================================================

# --- Application ---
APP_NAME=PDF Chat
APP_ENV=development
DEBUG=true

# --- OpenAI ---
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Database ---
DATABASE_URL=sqlite:///./data/pdf_chat.db

# --- RAG / Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_K=4

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=25

# --- Security ---
SECRET_KEY=change-this-secret-key-in-production

# --- CORS (comma separated list is parsed as JSON array by pydantic; use default) ---
ALLOWED_ORIGINS=["*"]

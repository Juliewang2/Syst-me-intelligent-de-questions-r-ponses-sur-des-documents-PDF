# ============================================================
# PDF Chat - Environment Configuration
# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env
# ============================================================

# --- Application ---
APP_NAME=PDF Chat
APP_ENV=development
DEBUG=true

# --- OpenAI ---
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Fail (and for reranking, fall back) instead of hanging on a stalled connection
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# --- Deployment mode / model providers ---
# openai | mistral | souverain (all local, Ollama) | hybride (external chat
# models for public context, local for restricted context, local embeddings)
DEPLOYMENT_MODE=openai
# Optional per-role overrides: provider (openai | mistral | ollama) and model.
# Empty = the deployment mode's default. Roles: generate, rerank, rewrite, verify, agent
GENERATE_PROVIDER=
GENERATE_MODEL=
RERANK_PROVIDER=
RERANK_MODEL=
REWRITE_PROVIDER=
REWRITE_MODEL=
VERIFY_PROVIDER=
VERIFY_MODEL=
AGENT_PROVIDER=
AGENT_MODEL=
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed
# Local models served by Ollama (ollama pull qwen2.5:7b && ollama pull bge-m3)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_CHAT_MODEL=qwen2.5:7b
LOCAL_EMBEDDING_MODEL=bge-m3
LOCAL_TIMEOUT_SECONDS=120
# Providers allowed to receive restricted (DR_SIMULE) text, as a JSON list.
# Other providers are replaced by Ollama whenever the context is restricted.
DR_ALLOWED_PROVIDERS=["ollama"]

# --- Evaluation ---
# Model that grades answers in evaluation/run_eval.py (empty = OPENAI_CHAT_MODEL).
# Keep it fixed when comparing systems so the grading standard doesn't change.
JUDGE_MODEL=

# --- Database ---
DATABASE_URL=sqlite:///./data/pdf_chat.db

# --- RAG / Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_K=4

# --- Retrieval quality ---
# Hybrid = vector (semantic) + BM25 (keyword) search, merged with Reciprocal Rank Fusion
HYBRID_SEARCH_ENABLED=true
# Candidates each retriever contributes before fusion / reranking
RETRIEVAL_CANDIDATES=12
# Vector hits with cosine similarity below this are dropped as irrelevant
MIN_VECTOR_SIMILARITY=0.2
# Let the chat model score candidates 0-10 and drop those below RERANK_MIN_SCORE
RERANK_ENABLED=true
RERANK_MIN_SCORE=4
RERANK_TIMEOUT_SECONDS=20

# --- Diplomatic corpus ---
# Read per-document metadata (sidecar .json next to each PDF, or the upload's
# metadata field) and copy it onto chunks so retrieval can filter on it.
# When enabled, a document without metadata is treated as DR_SIMULE (restricted).
CORPUS_METADATA_ENABLED=false
# Where scripts/download_public_corpus.py saves public documents
PUBLIC_CORPUS_DIR=./data/corpus/public
# SQLite database built by scripts/load_un_votes.py
UN_VOTES_DB_PATH=./data/un_votes.sqlite

# --- OCR (scanned PDFs) ---
OCR_ENABLED=true
# Pages with fewer extracted characters than this are OCR'd
OCR_MIN_CHARS=20
OCR_RENDER_SCALE=2.0

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=25

# --- Security ---
# Signs login tokens. MUST be changed (to a long random string) before deploying;
# the app refuses to start with the default when APP_ENV=production.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Leave empty to allow open registration; set a value to require an invite code.
REGISTRATION_INVITE_CODE=

# --- CORS (comma separated list is parsed as JSON array by pydantic; use default) ---
ALLOWED_ORIGINS=["*"]


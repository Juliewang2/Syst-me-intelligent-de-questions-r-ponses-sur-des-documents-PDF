# ============================================================
# PDF Chat - Environment Configuration
# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env
# ============================================================

# --- Application ---
APP_NAME=PDF Chat
APP_ENV=development
DEBUG=true

# --- OpenAI ---
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Fail (and for reranking, fall back) instead of hanging on a stalled connection
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# --- Database ---
DATABASE_URL=sqlite:///./data/pdf_chat.db

# --- RAG / Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_K=4

# --- Retrieval quality ---
# Hybrid = vector (semantic) + BM25 (keyword) search, merged with Reciprocal Rank Fusion
HYBRID_SEARCH_ENABLED=true
# Candidates each retriever contributes before fusion / reranking
RETRIEVAL_CANDIDATES=12
# Vector hits with cosine similarity below this are dropped as irrelevant
MIN_VECTOR_SIMILARITY=0.2
# Let the chat model score candidates 0-10 and drop those below RERANK_MIN_SCORE
RERANK_ENABLED=true
RERANK_MIN_SCORE=4
RERANK_TIMEOUT_SECONDS=20

# --- OCR (scanned PDFs) ---
OCR_ENABLED=true
# Pages with fewer extracted characters than this are OCR'd
OCR_MIN_CHARS=20
OCR_RENDER_SCALE=2.0

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=25

# --- Security ---
# Signs login tokens. MUST be changed (to a long random string) before deploying;
# the app refuses to start with the default when APP_ENV=production.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Leave empty to allow open registration; set a value to require an invite code.
REGISTRATION_INVITE_CODE=

# --- CORS (comma separated list is parsed as JSON array by pydantic; use default) ---
ALLOWED_ORIGINS=["*"]

